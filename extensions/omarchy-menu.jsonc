{
  // NeonFX menu extension for Omarchy Quickshell
  // Selecting Neon FX opens the Live Sliders & Controls GUI directly
  "style.neon": {
    "icon": "⚡",
    "label": "Neon FX",
    "action": "omarchy-neonfx-gui",
    "when": "name=$(cat ~/.local/state/omarchy/current/theme.name 2>/dev/null || cat ~/.config/omarchy/current/theme.name 2>/dev/null); [[ $name == neonfx ]]"
  },
  "style.font-size": {
    "icon": "",
    "label": "Ghostty Font Size"
  },
  "style.font-size.8": {
    "icon": "",
    "label": "8 pt",
    "checked": "[[ \"$(grep -oP '^font-size = \\K[0-9.]+' ~/.config/ghostty/config 2>/dev/null | head -1)\" == \"8\" ]]",
    "action": "omarchy-neonfx-toggle font-size 8"
  },
  "style.font-size.9": {
    "icon": "",
    "label": "9 pt",
    "checked": "[[ \"$(grep -oP '^font-size = \\K[0-9.]+' ~/.config/ghostty/config 2>/dev/null | head -1)\" == \"9\" ]]",
    "action": "omarchy-neonfx-toggle font-size 9"
  },
  "style.font-size.10": {
    "icon": "",
    "label": "10 pt",
    "checked": "[[ \"$(grep -oP '^font-size = \\K[0-9.]+' ~/.config/ghostty/config 2>/dev/null | head -1)\" == \"10\" ]]",
    "action": "omarchy-neonfx-toggle font-size 10"
  },
  "style.font-size.11": {
    "icon": "",
    "label": "11 pt",
    "checked": "[[ \"$(grep -oP '^font-size = \\K[0-9.]+' ~/.config/ghostty/config 2>/dev/null | head -1)\" == \"11\" ]]",
    "action": "omarchy-neonfx-toggle font-size 11"
  },
  "style.font-size.12": {
    "icon": "",
    "label": "12 pt",
    "checked": "[[ \"$(grep -oP '^font-size = \\K[0-9.]+' ~/.config/ghostty/config 2>/dev/null | head -1)\" == \"12\" ]]",
    "action": "omarchy-neonfx-toggle font-size 12"
  },
  "style.font-size.14": {
    "icon": "",
    "label": "14 pt",
    "checked": "[[ \"$(grep -oP '^font-size = \\K[0-9.]+' ~/.config/ghostty/config 2>/dev/null | head -1)\" == \"14\" ]]",
    "action": "omarchy-neonfx-toggle font-size 14"
  },
  "style.font-size.16": {
    "icon": "",
    "label": "16 pt",
    "checked": "[[ \"$(grep -oP '^font-size = \\K[0-9.]+' ~/.config/ghostty/config 2>/dev/null | head -1)\" == \"16\" ]]",
    "action": "omarchy-neonfx-toggle font-size 16"
  }
}
