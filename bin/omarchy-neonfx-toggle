#!/bin/bash

# omarchy:summary=Toggle NeonFX shader effects
# omarchy:args=<effect|preset> [on|off|toggle]

set -euo pipefail

THEME_ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
TOGGLE_DIR="$HOME/.local/state/omarchy/toggles/neonfx"
APPLY="$HOME/.local/bin/omarchy-neonfx-apply"

if [[ ! -x "$APPLY" ]]; then
  APPLY="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/omarchy-neonfx-apply"
fi

mkdir -p "$TOGGLE_DIR"

fx_python() {
  python3 - "$THEME_ROOT" "$@" <<'EOF'
import sys
from pathlib import Path

theme_root = sys.argv[1]
sys.path.insert(0, str(Path(theme_root) / "lib"))
from fx_config import (
    apply_cli_preset,
    load_raw_config,
    parse_set_value,
    save_config,
    sync_toggles,
)

cmd = sys.argv[2]
if cmd == "preset":
    apply_cli_preset(sys.argv[3])
elif cmd == "import":
    import json, os

    src = sys.argv[3]
    if not os.path.exists(src):
        print(f"Error: File not found: {src}", file=sys.stderr)
        sys.exit(1)
    with open(src, "r") as f:
        imported = json.load(f)
    if not isinstance(imported, dict):
        print("Error: Invalid JSON format (expected object)", file=sys.stderr)
        sys.exit(1)
    cfg = load_raw_config()
    cfg.update(imported)
    save_config(cfg)
    sync_toggles(cfg, only_present_keys=True)
    print(f"Imported Neon FX settings from: {src}")
elif cmd == "export":
    import json

    dest = sys.argv[3] if len(sys.argv) > 3 else ""
    output = json.dumps(load_raw_config(), indent=2)
    if dest:
        with open(dest, "w") as f:
            f.write(output + "\n")
        print(f"Exported Neon FX settings to: {dest}")
    else:
        print(output)
elif cmd == "set":
    cfg = load_raw_config()
    cfg[sys.argv[3]] = parse_set_value(sys.argv[4])
    save_config(cfg)
    sync_toggles(cfg, only_present_keys=True)
else:
    print(f"Unknown fx_python command: {cmd}", file=sys.stderr)
    sys.exit(2)
EOF
}

notify_fx() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -u low "Neon FX" "$1" || true
}

fx_set() {
  local key="$1"
  local action="${2:-toggle}"

  case "$action" in
  on) touch "$TOGGLE_DIR/$key" ;;
  off) rm -f "$TOGGLE_DIR/$key" ;;
  toggle)
    if [[ -f "$TOGGLE_DIR/$key" ]]; then
      rm -f "$TOGGLE_DIR/$key"
    else
      touch "$TOGGLE_DIR/$key"
    fi
    ;;
  *)
    echo "Usage: omarchy-neonfx-toggle <effect|preset> [on|off|toggle]"
    exit 1
    ;;
  esac
}

if [[ $# -lt 1 ]]; then
  echo "Usage: omarchy-neonfx-toggle <bloom|cursor-trail|cursor-glitch|terminal-crt|bloom-intensity|trail-style|preset-off|preset-subtle|preset-terminal|preset-full> [on|off|toggle|subtle|medium|intense|<style-id>]"
  exit 1
fi

case "$1" in
export)
  fx_python export "${2:-}"
  exit 0
  ;;
import)
  if [[ $# -lt 2 ]]; then
    echo "Usage: omarchy-neonfx-toggle import <file.json>"
    exit 1
  fi
  fx_python import "$2"
  ;;
gui | control | sliders)
  exec "$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/omarchy-neonfx-gui" "$@"
  ;;
font-size)
  if [[ $# -lt 2 ]]; then
    echo "Usage: omarchy-neonfx-toggle font-size <pt>"
    exit 1
  fi
  python3 - "$THEME_ROOT" "$2" <<'EOF'
import sys
from pathlib import Path

sys.path.insert(0, str(Path(sys.argv[1]) / "lib"))
from text_size import apply_font_size

sys.exit(apply_font_size(sys.argv[2]).returncode)
EOF
  exit $?
  ;;
set)
  if [[ $# -lt 3 ]]; then
    echo "Usage: omarchy-neonfx-toggle set <key> <value>"
    exit 1
  fi
  fx_python set "$2" "$3"
  ;;
trail-style)
  if [[ $# -lt 2 ]]; then
    echo "Usage: omarchy-neonfx-toggle trail-style <id>"
    exit 1
  fi
  fx_python set trail_style "$2"
  ;;
preset-off) fx_python preset off ;;
preset-subtle) fx_python preset subtle ;;
preset-terminal) fx_python preset terminal ;;
preset-full) fx_python preset full ;;
bloom-intensity)
  intensity="${2:-medium}"
  case "$intensity" in
  subtle | medium | intense)
    echo "$intensity" >"$TOGGLE_DIR/bloom-intensity"
    touch "$TOGGLE_DIR/bloom"
    ;;
  *)
    echo "Unknown intensity: $intensity (use subtle, medium, or intense)"
    exit 1
    ;;
  esac
  ;;
bloom | cursor-trail | cursor-glitch | terminal-crt)
  fx_set "$1" "${2:-toggle}"
  ;;
*)
  echo "Unknown effect: $1"
  exit 1
  ;;
esac

"$APPLY"

if [[ $# -eq 1 || $2 != toggle ]]; then
  case "$1" in
  preset-off) notify_fx "All effects off" ;;
  preset-subtle) notify_fx "Subtle glow enabled" ;;
  preset-terminal) notify_fx "Terminal stack enabled" ;;
  preset-full) notify_fx "Full stack enabled" ;;
  bloom-intensity) notify_fx "Bloom intensity set to $intensity" ;;
  trail-style) notify_fx "Trail style set to $2" ;;
  bloom | cursor-trail | cursor-glitch | terminal-crt)
    if [[ -f "$TOGGLE_DIR/$1" ]]; then
      notify_fx "${1//-/ } enabled"
    else
      notify_fx "${1//-/ } disabled"
    fi
    ;;
  esac
fi
