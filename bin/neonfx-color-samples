#!/usr/bin/env bash
# Preview candidate default text colors for NeonFX.
#
# Usage:
#   neonfx-color-samples          # open HTML preview in browser (default)
#   neonfx-color-samples --html   # write HTML only, print path
#   neonfx-color-samples --terminal

set -euo pipefail

BG="#0c0018"
OUT="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/neonfx/color-samples.html"

hex_to_rgb() {
  local hex="${1#\#}"
  printf '%d %d %d' $((16#${hex:0:2})) $((16#${hex:2:2})) $((16#${hex:4:2}))
}

fg() {
  local r g b
  read -r r g b <<< "$(hex_to_rgb "$1")"
  printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"
}

on_bg() {
  local r g b
  read -r r g b <<< "$(hex_to_rgb "$BG")"
  printf '\033[48;2;%d;%d;%dm' "$r" "$g" "$b"
}

reset() { printf '\033[0m'; }
dim()   { printf '\033[2m'; }

sample_line() {
  local label="$1" hex="$2" sentence="$3"
  printf '%b%b%s%b  %b#%s%b\n' \
    "$(on_bg)" "$(fg "$hex")" "$label — $sentence" "$(reset)" \
    "$(dim)" "${hex#\#}" "$(reset)"
}

prompt_demo() {
  local base_hex="$1" label="$2"
  printf '%b' "$(on_bg)"
  printf '%b  %s — ' "$(fg "$base_hex")" "$label"
  printf '%bcd ' "$(fg "$base_hex")"
  printf '%b~/projects' "$(fg "#00f5ff")"
  printf '%b && ' "$(fg "$base_hex")"
  printf '%bgit ' "$(fg "#ff0099")"
  printf '%bstatus' "$(fg "#ff66cc")"
  printf '%b — branch ' "$(fg "$base_hex")"
  printf '%bmain' "$(fg "#ff33aa")"
  printf '%b, ' "$(fg "$base_hex")"
  printf '%b3 files changed' "$(fg "#33ffb8")"
  printf '%b\n' "$(reset)"
}

write_html() {
  mkdir -p "$(dirname "$OUT")"
  cat >"$OUT" <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>NeonFX — text color samples</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 2rem;
      background: #0c0018;
      color: #7a6a98;
      font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", ui-monospace, monospace;
      font-size: 14px;
      line-height: 1.6;
    }
    h1 {
      color: #ece6ff;
      font-size: 1.25rem;
      font-weight: 600;
      margin: 0 0 0.25rem;
    }
    .sub { margin: 0 0 2rem; font-size: 0.85rem; }
    section { margin-bottom: 2rem; }
    h2 {
      color: #5a3a88;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin: 0 0 0.75rem;
    }
    .row {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding: 0.45rem 0.75rem;
      border-radius: 4px;
      margin-bottom: 0.35rem;
      background: #0c0018;
    }
    .row .hex {
      flex: 0 0 5.5rem;
      color: #5a3a88;
      font-size: 0.8rem;
    }
    .row .text { flex: 1; }
    .swatch {
      flex: 0 0 1rem;
      width: 1rem;
      height: 1rem;
      border-radius: 2px;
      border: 1px solid #3d2a5c;
      align-self: center;
    }
    .prompt { font-size: 0.95rem; }
  </style>
</head>
<body>
  <h1>NeonFX — text color samples</h1>
  <p class="sub">Background: <span style="color:#ece6ff">#0c0018</span> — pick a default text color; accents stay neon.</p>

  <section>
    <h2>Candidate default text colors</h2>
HTML

  local rows=(
    "Current terminal (colors.toml)|#ffb3e6|The quick brown fox jumps over the lazy dog. ls -la ~/projects"
    "Ice lavender (waybar/btop)|#ece6ff|The quick brown fox jumps over the lazy dog. ls -la ~/projects"
    "Soft silver|#c8d8f0|The quick brown fox jumps over the lazy dog. ls -la ~/projects"
    "Cool cyan-white|#d0f5ff|The quick brown fox jumps over the lazy dog. ls -la ~/projects"
    "Muted purple|#b8a8d0|The quick brown fox jumps over the lazy dog. ls -la ~/projects"
    "Bright slot (color15)|#ffd6f5|The quick brown fox jumps over the lazy dog. ls -la ~/projects"
    "Soft purple (comments)|#7a6a98|The quick brown fox jumps over the lazy dog. ls -la ~/projects"
  )

  for row in "${rows[@]}"; do
    IFS='|' read -r label hex text <<< "$row"
    printf '    <div class="row"><span class="swatch" style="background:%s"></span><span class="hex">%s</span><span class="text" style="color:%s">%s — %s</span></div>\n' \
      "$hex" "$hex" "$hex" "$label" "$text" >>"$OUT"
  done

  cat >>"$OUT" <<'HTML'
  </section>

  <section>
    <h2>With accent colors mixed in</h2>
HTML

  cat >>"$OUT" <<HTML
    <div class="row prompt">
      <span class="hex">#ece6ff</span>
      <span class="text">
        <span style="color:#ece6ff">Ice lavender base — cd </span><span style="color:#00f5ff">~/projects</span><span style="color:#ece6ff"> &amp;&amp; </span><span style="color:#ff0099">git </span><span style="color:#ff66cc">status</span><span style="color:#ece6ff"> — branch </span><span style="color:#ff33aa">main</span><span style="color:#ece6ff">, </span><span style="color:#33ffb8">3 files changed</span>
      </span>
    </div>
    <div class="row prompt">
      <span class="hex">#ffb3e6</span>
      <span class="text">
        <span style="color:#ffb3e6">Current pink base — cd </span><span style="color:#00f5ff">~/projects</span><span style="color:#ffb3e6"> &amp;&amp; </span><span style="color:#ff0099">git </span><span style="color:#ff66cc">status</span><span style="color:#ffb3e6"> — branch </span><span style="color:#ff33aa">main</span><span style="color:#ffb3e6">, </span><span style="color:#33ffb8">3 files changed</span>
      </span>
    </div>
  </section>

  <section>
    <h2>Accents (unchanged)</h2>
HTML

  local accents=(
    "Cyan accent|#00f5ff|paths, keywords, cursor"
    "Magenta accent|#ff0099|commands, selection"
    "Pink accent|#ff33aa|git branch, highlights"
    "Mint accent|#33ffb8|success, executables"
  )

  for row in "${accents[@]}"; do
    IFS='|' read -r label hex text <<< "$row"
    printf '    <div class="row"><span class="swatch" style="background:%s"></span><span class="hex">%s</span><span class="text" style="color:%s">%s — %s</span></div>\n' \
      "$hex" "$hex" "$hex" "$label" "$text" >>"$OUT"
  done

  cat >>"$OUT" <<'HTML'
  </section>
</body>
</html>
HTML
}

show_terminal() {
  if [[ ! -t 1 ]]; then
    echo "stdout is not a TTY — use default (HTML) mode instead." >&2
    exit 1
  fi

  local sentence="The quick brown fox jumps over the lazy dog. ls -la ~/projects"

  printf '\n'
  printf '%bNeonFX — text color samples%b\n' "$(dim)" "$(reset)"
  printf '%bBackground: %s%b\n\n' "$(dim)" "$BG" "$(reset)"

  sample_line "Current terminal (colors.toml)" "#ffb3e6" "$sentence"
  sample_line "Ice lavender (waybar/btop)"     "#ece6ff" "$sentence"
  sample_line "Soft silver"                    "#c8d8f0" "$sentence"
  sample_line "Cool cyan-white"                "#d0f5ff" "$sentence"
  sample_line "Muted purple"                   "#b8a8d0" "$sentence"
  sample_line "Bright slot (color15)"          "#ffd6f5" "$sentence"
  sample_line "Soft purple (comments)"         "#7a6a98" "$sentence"

  printf '\n%bWith accent colors mixed in:%b\n' "$(dim)" "$(reset)"
  prompt_demo "#ece6ff" "Ice lavender base"
  prompt_demo "#ffb3e6" "Current pink base"

  printf '\n%bAccents (unchanged):%b\n' "$(dim)" "$(reset)"
  sample_line "Cyan accent"    "#00f5ff" "paths, keywords, cursor"
  sample_line "Magenta accent" "#ff0099" "commands, selection"
  sample_line "Pink accent"    "#ff33aa" "git branch, highlights"
  sample_line "Mint accent"    "#33ffb8" "success, executables"
  printf '\n'
}

open_html() {
  write_html
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$OUT" >/dev/null 2>&1 &
    echo "Opened $OUT"
  elif command -v open >/dev/null 2>&1; then
    open "$OUT"
    echo "Opened $OUT"
  else
    echo "Wrote $OUT"
    echo "Open that file in a browser."
  fi
}

case "${1:-}" in
  --terminal|-t) show_terminal ;;
  --html|-h)
    write_html
    echo "$OUT"
    ;;
  --help)
    sed -n '2,6p' "$0" | sed 's/^# \?//'
    ;;
  "") open_html ;;
  *)
    echo "Unknown option: $1" >&2
    echo "Try: $0 --help" >&2
    exit 1
    ;;
esac
