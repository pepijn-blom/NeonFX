        self.set_default_size(560, 800)
        self.cfg = load_config()

        # Guard flag so widget setup signals NEVER trigger saves
        self._updating_ui = True
        self._save_timeout_id = None
        self._font_timeout_id = None
        self._font_size = current_font_size()
        self.scales = {}
        self.trail_studio_win = None

        # Apply CSS styling for Synthwave/Cyberpunk look
        css_provider = Gtk.CssProvider()
        css = """
        window {
            background-color: #0c0018;
