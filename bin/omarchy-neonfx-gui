        self.trail_color_btn.set_rgba(hex_to_rgba(current_color))
        self.trail_color_btn.connect("notify::rgba", self.on_color_btn_changed)
        color_box.append(self.trail_color_btn)

        self.trail_color_row.add_suffix(color_box)
        trail_group.add(self.trail_color_row)

        self.trail_duration_row = self.create_slider_row(
