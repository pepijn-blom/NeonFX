        studio_btn_box.append(open_studio_btn)

        studio_row.add_suffix(studio_btn_box)
        trail_group.add(studio_row)

        # 4. Cursor Glitch Group
        glitch_group = Adw.PreferencesGroup()
        glitch_group.set_title("󱓞 Cursor Glitch / Burst")
        glitch_group.set_description("Digital glitch tear when typing and changing cursor modes")
        box.append(glitch_group)

        self.glitch_switch = Adw.SwitchRow(title="Enable Cursor Glitch")
        self.glitch_switch.set_active(bool(self.cfg.get("glitch_enabled", True)))
        self.glitch_switch.connect("notify::active", lambda w, p: self.on_switch_change("glitch_enabled", w.get_active()))
        glitch_group.add(self.glitch_switch)

        self.glitch_strength_row = self.create_slider_row(
            "Tear Strength",
            "glitch_strength",
            min_val=0.005,
            max_val=0.080,
            step=0.001,
            digits=3,
        )
        glitch_group.add(self.glitch_strength_row)

        self.glitch_duration_row = self.create_slider_row(
            "Glitch Duration (s)",
            "glitch_duration",
            min_val=0.10,
            max_val=0.80,
            step=0.01,
            digits=2,
        )
        glitch_group.add(self.glitch_duration_row)

        # 5. CRT Scanlines Group
        crt_group = Adw.PreferencesGroup()
        crt_group.set_title("󱓞 CRT Scanlines & Vignette")
        crt_group.set_description("Retro terminal scanlines, subtle vignette, and chromatic aberration")
        box.append(crt_group)

        self.crt_switch = Adw.SwitchRow(title="Enable CRT Scanlines")
        self.crt_switch.set_active(bool(self.cfg.get("crt_enabled", True)))
        self.crt_switch.connect("notify::active", lambda w, p: self.on_switch_change("crt_enabled", w.get_active()))
        crt_group.add(self.crt_switch)

        self.scanline_row = self.create_slider_row(
            "Scanline Intensity",
            "scanline_strength",
            min_val=0.00,
            max_val=0.85,
            step=0.02,
            digits=2,
        )
        crt_group.add(self.scanline_row)

        self.scanline_spacing_row = self.create_slider_row(
            "Scanline Beam Pitch (px)",
            "scanline_spacing",
            min_val=1.0,
            max_val=6.0,
            step=0.5,
            digits=1,
        )
        crt_group.add(self.scanline_spacing_row)

        self.vignette_row = self.create_slider_row(
            "Vignette Darkness",
            "vignette_strength",
            min_val=0.00,
            max_val=0.60,
            step=0.02,
            digits=2,
        )
        crt_group.add(self.vignette_row)

        self.aberration_row = self.create_slider_row(
            "Chromatic Aberration",
            "aberration_strength",
            min_val=0.0000,
            max_val=0.0080,
            step=0.0005,
            digits=4,
        )
        crt_group.add(self.aberration_row)

        # 6. Backup & Profiles (Export / Import) Group
        backup_group = Adw.PreferencesGroup()
        backup_group.set_title("📦 Backup & Profiles")
        backup_group.set_description(f"Config stored at: ~/.local/state/omarchy/neonfx/fx-config.json")
        box.append(backup_group)

        # File actions row
        file_row = Adw.ActionRow(title="Configuration Files", subtitle="Save or restore full settings JSON")
        file_btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        file_btn_box.set_valign(Gtk.Align.CENTER)

        exp_btn = Gtk.Button(label="Export File...")
        exp_btn.add_css_class("action-btn")
        exp_btn.connect("clicked", self.on_export_clicked)
        file_btn_box.append(exp_btn)

        imp_btn = Gtk.Button(label="Import File...")
        imp_btn.add_css_class("action-btn")
        imp_btn.connect("clicked", self.on_import_clicked)
        file_btn_box.append(imp_btn)

        file_row.add_suffix(file_btn_box)
        backup_group.add(file_row)

        # Status feedback label
        self.status_label = Gtk.Label(label="")
        self.status_label.add_css_class("status-label")
        self.status_label.set_margin_top(4)
        box.append(self.status_label)

        # Ready for user input after idle cycle
        GLib.idle_add(self._finish_ui_init)

    def _finish_ui_init(self):
        self._updating_ui = False
        return False

    def show_status_msg(self, msg):
        self.status_label.set_text(msg)
        GLib.timeout_add(3500, lambda: self.status_label.set_text("") or False)

    def open_trail_studio(self):
        if self.trail_studio_win is None:
            self.trail_studio_win = TrailFxStudioWindow(self)
        self.trail_studio_win.sync_from_config()
        self.trail_studio_win.present()

    def on_close_request(self, win):
        if self.trail_studio_win:
            self.trail_studio_win.destroy()
            self.trail_studio_win = None
        return False



    def on_export_clicked(self, widget):
        dialog = Gtk.FileDialog.new()
        dialog.set_title("Export Neon FX Settings")
        dialog.set_initial_name("neonfx-fx.json")

        def on_save_finish(dialog, result):
            try:
                gfile = dialog.save_finish(result)
                path = gfile.get_path()
                if path:
                    with open(path, "w") as f:
                        json.dump(self.cfg, f, indent=2)
                    self.show_status_msg(f"✓ Exported to {os.path.basename(path)}")
            except Exception:
                pass

        dialog.save(self, None, on_save_finish)

    def on_import_clicked(self, widget):
        dialog = Gtk.FileDialog.new()
        dialog.set_title("Import Neon FX Settings")

        def on_open_finish(dialog, result):
            try:
                gfile = dialog.open_finish(result)
                path = gfile.get_path()
                if path and os.path.exists(path):
                    with open(path, "r") as f:
                        imported = json.load(f)
                    if isinstance(imported, dict):
                        self.apply_preset_dict(imported)
                        self.show_status_msg(f"✓ Imported from {os.path.basename(path)}")
            except Exception:
                self.show_status_msg("!! Invalid JSON file")

        dialog.open(self, None, on_open_finish)

    def create_slider_row(self, title, key, min_val, max_val, step, digits=2):
        row = Adw.ActionRow(title=title)
        val = float(self.cfg.get(key, DEFAULT_CONFIG.get(key, min_val)))

        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, min_val, max_val, step)
        scale.set_value(val)
        scale.set_digits(digits)
        scale.set_value_pos(Gtk.PositionType.RIGHT)
        scale.set_draw_value(True)
        scale.set_hexpand(True)
        scale.set_size_request(180, -1)

        scale.connect("value-changed", lambda s, k=key, d=digits: self.on_slider_change(k, s.get_value(), d))
        row.add_suffix(scale)

        self.scales[key] = scale
        return row

    def on_font_size_change(self, scale):
        if self._updating_ui:
            return
        new_val = clamp_font_size(scale.get_value())
        if new_val == self._font_size:
            return
        self._font_size = new_val
        if self._font_timeout_id is not None:
            GLib.source_remove(self._font_timeout_id)
        self._font_timeout_id = GLib.timeout_add(200, self._do_apply_font_size)

    def _do_apply_font_size(self):
        self._font_timeout_id = None
        result = apply_font_size(self._font_size)
        if getattr(result, "returncode", 1) != 0:
            err = getattr(result, "stderr", b"") or b""
            if isinstance(err, bytes):
                err = err.decode("utf-8", "replace").strip()
            self.show_status_msg(err or "!! Could not set Ghostty font size")
        else:
            self.show_status_msg(f"✓ Ghostty font size {self._font_size} pt")
        return False

    def on_slider_change(self, key, value, digits, source="main"):
        if self._updating_ui:
            return
        new_val = round(float(value), digits)
        if self.cfg.get(key) == new_val:
            return
        self.cfg[key] = new_val
        self.sync_all_views(source=source)
        self.schedule_apply()

    def on_switch_change(self, key, active, source="main"):
        if self._updating_ui:
            return
        if self.cfg.get(key) == bool(active):
            return
        self.cfg[key] = bool(active)
        self.sync_all_views(source=source)
        self.schedule_apply()

    def set_trail_color(self, hex_str, source="main"):
        if self._updating_ui:
            return
        if self.cfg.get("trail_color") == hex_str:
            return
        self.cfg["trail_color"] = hex_str
        self.sync_all_views(source=source)
        self.schedule_apply()

    def set_trail_style(self, style_id, source="main"):
        if self._updating_ui:
            return
        style_id = resolve_trail_style(style_id)
        if self.cfg.get("trail_style") == style_id:
            return
        self.cfg["trail_style"] = style_id
        self.sync_all_views(source=source)
        self.schedule_apply()

    def on_color_btn_changed(self, btn, pspec):
        if self._updating_ui:
            return
        rgba = btn.get_rgba()
        self.set_trail_color(rgba_to_hex(rgba), source="main")

    def on_hex_entry_changed(self, entry):
        if self._updating_ui:
            return
        text = entry.get_text().strip()
        if not text.startswith("#"):
            text = "#" + text
        if len(text) == 7 and re.match(r"^#[0-9a-fA-F]{6}$", text):
            self.set_trail_color(text.lower(), source="main")

    def sync_all_views(self, source="none"):
        # Update Main Window widgets if changed from Studio or Presets
        if source != "main":
            prev_main = self._updating_ui
            self._updating_ui = True

            self.bloom_switch.set_active(bool(self.cfg.get("bloom_enabled", True)))
            self.trail_switch.set_active(bool(self.cfg.get("trail_enabled", True)))
            self.glitch_switch.set_active(bool(self.cfg.get("glitch_enabled", True)))
            self.crt_switch.set_active(bool(self.cfg.get("crt_enabled", True)))

            trail_color = self.cfg.get("trail_color", "#00f5ff")
            self.trail_color_entry.set_text(trail_color)
            self.trail_color_btn.set_rgba(hex_to_rgba(trail_color))

            for key, scale in self.scales.items():
                if key in self.cfg:
                    target_val = float(self.cfg[key])
                    if abs(scale.get_value() - target_val) > 1e-5:
                        scale.set_value(target_val)

            self._updating_ui = prev_main

        # Update Studio Window widgets if open and changed from Main or Presets
        if self.trail_studio_win and self.trail_studio_win.is_visible() and source != "studio":
            self.trail_studio_win.sync_from_config()

    def schedule_apply(self):
        if self._save_timeout_id is not None:
            GLib.source_remove(self._save_timeout_id)
        self._save_timeout_id = GLib.timeout_add(160, self._do_save_and_apply)

    def _do_save_and_apply(self):
        self._save_timeout_id = None
        save_and_apply_config(self.cfg)
        return False

    def apply_preset_dict(self, preset_dict):
        self.cfg.update(preset_dict)
        self.sync_all_views(source="preset")
        self.schedule_apply()



class FxApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.omarchy.neonfx")

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = FxControlWindow(self)
        win.present()


if __name__ == "__main__":
    app = FxApp()
    sys.exit(app.run(sys.argv))
