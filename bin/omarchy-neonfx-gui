#!/usr/bin/env python3
"""
NeonFX FX Live Control Center (GTK4 / Libadwaita)
Real-time slider, color & profile controls for Ghostty shaders (Bloom, Trail, Glitch, CRT).
Includes Popout Cursor Trail FX Studio (Trail Bloom, Glitch & Chromatic Aberration).
"""

import os
import sys
import json
import re
import subprocess
import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, GLib, Gdk

THEME_ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
sys.path.insert(0, os.path.join(THEME_ROOT, "lib"))
from fx_config import (  # noqa: E402
    COMET_SMEAR_STYLE,
    CONFIG_FILE,
    DEFAULT_CONFIG,
    PRESETS,
    STATE_DIR,
    TOGGLE_DIR,
    TRAIL_STYLES,
    load_config,
    resolve_trail_style,
    save_config,
    sync_toggles,
)
from text_size import (  # noqa: E402
    FONT_SIZE_MAX,
    FONT_SIZE_MIN,
    apply_font_size,
    clamp_font_size,
    current_font_size,
)


def hex_to_rgba(hex_str):
    rgba = Gdk.RGBA()
    hex_str = str(hex_str).strip()
    if not hex_str.startswith("#"):
        hex_str = "#" + hex_str
    if not rgba.parse(hex_str):
        rgba.parse("#00f5ff")
    return rgba


def rgba_to_hex(rgba):
    r = int(round(rgba.red * 255))
    g = int(round(rgba.green * 255))
    b = int(round(rgba.blue * 255))
    return f"#{r:02x}{g:02x}{b:02x}"


def save_and_apply_config(cfg):
    save_config(cfg, CONFIG_FILE)
    sync_toggles(cfg, TOGGLE_DIR)
    apply_bin = os.path.join(THEME_ROOT, "bin", "omarchy-neonfx-apply")
    if os.path.exists(apply_bin):
        subprocess.run([apply_bin], capture_output=True)


class TrailFxStudioWindow(Adw.Window):
    """
    Dedicated popout window for all Trail-specific FX:
    Base Motion, Trail Bloom Halo, Trail Glitch Jitter, and Trail Chromatic Aberration.
    """
    def __init__(self, parent_window):
        super().__init__(title="󱓞 Cursor Trail FX Studio")
        self.set_transient_for(parent_window)
        self.set_modal(False)
        self.set_default_size(540, 740)
        self.parent_window = parent_window
        self.cfg = parent_window.cfg
        self.scales = {}

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_content(content)

        header = Adw.HeaderBar()
        content.append(header)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        content.append(scrolled)

        clamp = Adw.Clamp()
        clamp.set_maximum_size(580)
        clamp.set_tightening_threshold(460)
        scrolled.set_child(clamp)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_top(16)
        box.set_margin_bottom(24)
        box.set_margin_start(16)
        box.set_margin_end(16)
        clamp.set_child(box)

        style_group = Adw.PreferencesGroup()
        style_group.set_title("Trail Style")
        style_group.set_description("Cursor motion look. Blaze Spear is the default.")
        box.append(style_group)

        self.style_ids = [sid for sid, _label in TRAIL_STYLES]
        self.style_labels = [label for _sid, label in TRAIL_STYLES]
        self.style_row = Adw.ComboRow(title="Preset", subtitle="Live-swappable trail shader")
        self.style_row.set_model(Gtk.StringList.new(self.style_labels))
        current_style = resolve_trail_style(self.cfg.get("trail_style"))
        self.style_row.set_selected(self.style_ids.index(current_style))
        self.style_row.connect("notify::selected", self.on_style_changed)
        style_group.add(self.style_row)

        # 1. Base Trail & Motion Group
        base_group = Adw.PreferencesGroup()
        base_group.set_title("󱓞 Trail Motion & Color")
        base_group.set_description("Comet sweep duration, smear geometry, and palette")
        box.append(base_group)

        self.trail_switch = Adw.SwitchRow(title="Enable Cursor Trail")
        self.trail_switch.set_active(bool(self.cfg.get("trail_enabled", True)))
        self.trail_switch.connect("notify::active", lambda w, p: self.on_switch_change("trail_enabled", w.get_active()))
        base_group.add(self.trail_switch)

        # Trail Color Row
        self.trail_color_row = Adw.ActionRow(title="Trail Color", subtitle="Hex code (#00f5ff) or color picker")
        color_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        color_box.set_valign(Gtk.Align.CENTER)

        current_color = self.cfg.get("trail_color", "#00f5ff")

        self.trail_color_entry = Gtk.Entry()
        self.trail_color_entry.add_css_class("hex-entry")
        self.trail_color_entry.set_text(current_color)
        self.trail_color_entry.set_max_length(7)
        self.trail_color_entry.set_width_chars(8)
        self.trail_color_entry.set_alignment(0.5)
        self.trail_color_entry.connect("changed", self.on_hex_entry_changed)
        color_box.append(self.trail_color_entry)

        color_dialog = Gtk.ColorDialog.new()
        color_dialog.set_with_alpha(False)
        self.trail_color_btn = Gtk.ColorDialogButton.new(color_dialog)
        self.trail_color_btn.set_rgba(hex_to_rgba(current_color))
        self.trail_color_btn.connect("notify::rgba", self.on_color_btn_changed)
        color_box.append(self.trail_color_btn)

        self.trail_color_row.add_suffix(color_box)
        base_group.add(self.trail_color_row)

        self.trail_duration_row = self.create_slider_row("Trail Duration (s)", "trail_duration", 0.05, 0.60, 0.01, 2)
        base_group.add(self.trail_duration_row)

        self.trail_size_row = self.create_slider_row("Trail Smear Length", "trail_size", 0.10, 1.00, 0.05, 2)
        base_group.add(self.trail_size_row)

        self.trail_opacity_row = self.create_slider_row("Trail Opacity", "trail_opacity", 0.05, 1.00, 0.05, 2)
        base_group.add(self.trail_opacity_row)

        # 2. Trail Bloom Group
        self.bloom_group = Adw.PreferencesGroup()
        self.bloom_group.set_title("󰌵 Trail Bloom / Neon Halo")
        self.bloom_group.set_description("Ambient glowing neon bloom halo radiating around the moving trail")
        box.append(self.bloom_group)

        self.trail_bloom_switch = Adw.SwitchRow(title="Enable Trail Bloom")
        self.trail_bloom_switch.set_active(bool(self.cfg.get("trail_bloom_enabled", False)))
        self.trail_bloom_switch.connect("notify::active", lambda w, p: self.on_switch_change("trail_bloom_enabled", w.get_active()))
        self.bloom_group.add(self.trail_bloom_switch)

        self.trail_bloom_strength_row = self.create_slider_row("Bloom Glow Strength", "trail_bloom_strength", 0.00, 2.50, 0.05, 2)
        self.bloom_group.add(self.trail_bloom_strength_row)

        self.trail_bloom_radius_row = self.create_slider_row("Bloom Halo Radius (px)", "trail_bloom_radius", 0.5, 6.0, 0.1, 1)
        self.bloom_group.add(self.trail_bloom_radius_row)

        # 3. Trail Glitch Group
        self.glitch_group = Adw.PreferencesGroup()
        self.glitch_group.set_title("󱓞 Trail Glitch & Scanline Tear")
        self.glitch_group.set_description("Digital raster tear and electric static noise bursts along the comet tail")
        box.append(self.glitch_group)

        self.trail_glitch_switch = Adw.SwitchRow(title="Enable Trail Glitch")
        self.trail_glitch_switch.set_active(bool(self.cfg.get("trail_glitch_enabled", False)))
        self.trail_glitch_switch.connect("notify::active", lambda w, p: self.on_switch_change("trail_glitch_enabled", w.get_active()))
        self.glitch_group.add(self.trail_glitch_switch)

        self.trail_glitch_strength_row = self.create_slider_row("Tear Displacement Strength", "trail_glitch_strength", 0.005, 0.100, 0.002, 3)
        self.glitch_group.add(self.trail_glitch_strength_row)

        self.trail_glitch_static_row = self.create_slider_row("Digital Static Noise Density", "trail_glitch_static", 0.000, 0.017, 0.001, 3)
        self.glitch_group.add(self.trail_glitch_static_row)


        # 4. Trail Chromatic Aberration Group
        self.aberration_group = Adw.PreferencesGroup()
        self.aberration_group.set_title("󱓞 Trail Chromatic Aberration")
        self.aberration_group.set_description("RGB color channel fringe separation along the comet trail edges")
        box.append(self.aberration_group)

        self.trail_aberration_switch = Adw.SwitchRow(title="Enable Trail Chromatic Aberration")
        self.trail_aberration_switch.set_active(bool(self.cfg.get("trail_aberration_enabled", False)))
        self.trail_aberration_switch.connect("notify::active", lambda w, p: self.on_switch_change("trail_aberration_enabled", w.get_active()))
        self.aberration_group.add(self.trail_aberration_switch)

        self.trail_aberration_strength_row = self.create_slider_row("RGB Fringe Separation", "trail_aberration_strength", 0.0005, 0.0150, 0.0005, 4)
        self.aberration_group.add(self.trail_aberration_strength_row)

        self.update_style_sensitive()
        self.connect("close-request", self.on_close_request)

        self._updating_ui = True
        GLib.idle_add(self._finish_ui_init)

    def on_close_request(self, win):
        self.hide()
        return True


    def _finish_ui_init(self):
        self._updating_ui = False
        return False

    def create_slider_row(self, title, key, min_val, max_val, step, digits=2):
        row = Adw.ActionRow(title=title)
        val = float(self.cfg.get(key, DEFAULT_CONFIG.get(key, min_val)))

        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, min_val, max_val, step)
        scale.set_value(val)
        scale.set_digits(digits)
        scale.set_value_pos(Gtk.PositionType.RIGHT)
        scale.set_draw_value(True)
        scale.set_hexpand(True)
        scale.set_size_request(180, -1)

        scale.connect("value-changed", lambda s, k=key, d=digits: self.on_slider_change(k, s.get_value(), d))
        row.add_suffix(scale)

        self.scales[key] = scale
        return row

    def on_style_changed(self, row, pspec):
        if self._updating_ui:
            return
        idx = row.get_selected()
        if idx < 0 or idx >= len(self.style_ids):
            return
        self.parent_window.set_trail_style(self.style_ids[idx], source="studio")

    def update_style_sensitive(self):
        is_smear = resolve_trail_style(self.cfg.get("trail_style")) == COMET_SMEAR_STYLE
        self.trail_size_row.set_visible(is_smear)
        self.trail_opacity_row.set_visible(is_smear)
        self.bloom_group.set_visible(is_smear)
        self.glitch_group.set_visible(is_smear)
        self.aberration_group.set_visible(is_smear)

    def on_slider_change(self, key, value, digits):
        if self._updating_ui:
            return
        self.parent_window.on_slider_change(key, value, digits, source="studio")

    def on_switch_change(self, key, active):
        if self._updating_ui:
            return
        self.parent_window.on_switch_change(key, active, source="studio")

    def on_color_btn_changed(self, btn, pspec):
        if self._updating_ui:
            return
        rgba = btn.get_rgba()
        self.parent_window.set_trail_color(rgba_to_hex(rgba), source="studio")

    def on_hex_entry_changed(self, entry):
        if self._updating_ui:
            return
        text = entry.get_text().strip()
        if not text.startswith("#"):
            text = "#" + text
        if len(text) == 7 and re.match(r"^#[0-9a-fA-F]{6}$", text):
            self.parent_window.set_trail_color(text.lower(), source="studio")

    def sync_from_config(self):
        prev = self._updating_ui
        self._updating_ui = True

        self.trail_switch.set_active(bool(self.cfg.get("trail_enabled", True)))
        self.trail_bloom_switch.set_active(bool(self.cfg.get("trail_bloom_enabled", False)))
        self.trail_glitch_switch.set_active(bool(self.cfg.get("trail_glitch_enabled", False)))
        self.trail_aberration_switch.set_active(bool(self.cfg.get("trail_aberration_enabled", False)))

        trail_color = self.cfg.get("trail_color", "#00f5ff")
        self.trail_color_entry.set_text(trail_color)
        self.trail_color_btn.set_rgba(hex_to_rgba(trail_color))

        for key, scale in self.scales.items():
            if key in self.cfg:
                target_val = float(self.cfg[key])
                if abs(scale.get_value() - target_val) > 1e-5:
                    scale.set_value(target_val)

        style = resolve_trail_style(self.cfg.get("trail_style"))
        if style in self.style_ids:
            idx = self.style_ids.index(style)
            if self.style_row.get_selected() != idx:
                self.style_row.set_selected(idx)
        self.update_style_sensitive()

        self._updating_ui = prev



